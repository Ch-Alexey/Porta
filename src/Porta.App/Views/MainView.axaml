<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Porta.App.ViewModels"
             xmlns:design="using:Porta.App.Design"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Porta.App.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <design:DesignMainViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <!-- Шапка: личность устройства -->
        <Border DockPanel.Dock="Top" Padding="16" CornerRadius="8"
                BorderThickness="1" BorderBrush="Gray" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding DeviceName}" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding DeviceId}" FontFamily="monospace" FontSize="12"
                           TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
        </Border>

        <TabControl>
            <!-- Хранилища -->
            <TabItem Header="Хранилища">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12"
                            BorderThickness="1" CornerRadius="6" BorderBrush="Gray">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Добавить хранилище" FontWeight="SemiBold" />
                            <TextBox PlaceholderText="Имя" Text="{Binding Storages.NewName}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Обзор…" Margin="8,0,0,0"
                                        Command="{Binding Storages.BrowseCommand}" />
                                <TextBox PlaceholderText="Путь к папке" Text="{Binding Storages.NewPath}" />
                            </DockPanel>
                            <Button Content="Добавить" HorizontalAlignment="Right"
                                    Command="{Binding Storages.AddCommand}" />

                            <Separator />

                            <TextBlock Text="Поделиться папкой с устройством" FontWeight="SemiBold" />
                            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Хранилище"
                                      ItemsSource="{Binding Storages.Items}"
                                      SelectedItem="{Binding Storages.SelectedStorage}" />
                            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Устройство"
                                      ItemsSource="{Binding Storages.TrustedDevices}"
                                      SelectedItem="{Binding Storages.SelectedDevice}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Убрать доступ" Command="{Binding Storages.UnshareCommand}" />
                                <Button Content="Поделиться" Command="{Binding Storages.ShareCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Storages.StatusMessage}" Opacity="0.8" TextWrapping="Wrap"
                                       IsVisible="{Binding Storages.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Storages.Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageItem">
                                <DockPanel Margin="0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Content="{Binding SyncModeText}" FontSize="11"
                                                Command="{Binding ToggleSyncModeCommand}"
                                                ToolTip.Tip="Переключить авто/ручную синхронизацию" />
                                        <Button Content="Пауза" FontSize="11"
                                                Command="{Binding TogglePausedCommand}" />
                                        <Button Content="Убрать" FontSize="11"
                                                Command="{Binding RemoveCommand}"
                                                ToolTip.Tip="Убрать из синхронизации. Файлы на диске останутся" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LocalPath}" Opacity="0.7" FontSize="12" />
                                        <TextBlock Text="{Binding PausedText}" Opacity="0.6" FontSize="11"
                                                   IsVisible="{Binding PausedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding SharedWith, StringFormat='Общий доступ: {0}'}"
                                                   Opacity="0.6" FontSize="11"
                                                   IsVisible="{Binding SharedWith, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Устройства -->
            <TabItem Header="Устройства">
                <DockPanel Margin="0,12,0,0">
                    <!-- Связывание -->
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12"
                            BorderThickness="1" CornerRadius="6" BorderBrush="Gray">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Добавить устройство" FontWeight="SemiBold" />
                            <Button Content="Показать приглашение"
                                    Command="{Binding Devices.GenerateInvitationCommand}" />
                            <TextBox Text="{Binding Devices.InvitationToken}" IsReadOnly="True"
                                     FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                                     IsVisible="{Binding Devices.InvitationToken, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <Separator />

                            <TextBlock Text="Подключиться по токену" FontWeight="SemiBold" />
                            <TextBox PlaceholderText="Имя устройства" Text="{Binding Devices.NewDeviceName}" />
                            <TextBox PlaceholderText="porta:…" Text="{Binding Devices.PastedToken}"
                                     FontFamily="monospace" FontSize="11" />
                            <Button Content="Подключиться" HorizontalAlignment="Right"
                                    Command="{Binding Devices.ConnectCommand}" />
                            <TextBlock Text="{Binding Devices.StatusMessage}" Opacity="0.8"
                                       IsVisible="{Binding Devices.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Доверенные" FontWeight="SemiBold" Opacity="0.8" />
                            <ItemsControl ItemsSource="{Binding Devices.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceItem">
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Content="Отозвать" FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding RevokeCommand}"
                                                    ToolTip.Tip="Убрать доверие. Полученные файлы останутся" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DeviceId}" Opacity="0.7"
                                                           FontFamily="monospace" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Синхронизировать"
                                        Command="{Binding Devices.SyncWithFoundCommand}"
                                        IsEnabled="{Binding Devices.CanSync}" />
                                <TextBlock Text="Найдены в сети" FontWeight="SemiBold" Opacity="0.8"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Devices.DiscoveredPeers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoveredPeerItem">
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding DeviceId}" Opacity="0.6"
                                                       FontFamily="monospace" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <!-- Передача -->
            <TabItem Header="Передача">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,12"
                            BorderThickness="1" CornerRadius="6" BorderBrush="Gray">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Разовая отправка файлов" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Выбрать файлы…" Command="{Binding Transfers.PickFilesCommand}" />
                                <Button Content="Очистить" Command="{Binding Transfers.ClearSelectionCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Transfers.SelectionSummary}" Opacity="0.7" FontSize="12" />
                            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Кому отправить"
                                      ItemsSource="{Binding Transfers.Peers}"
                                      SelectedItem="{Binding Transfers.SelectedPeer}" />
                            <Button Content="Отправить" HorizontalAlignment="Right"
                                    Command="{Binding Transfers.SendCommand}"
                                    IsEnabled="{Binding !Transfers.IsSending}" />
                            <TextBlock Text="{Binding Transfers.StatusMessage}" Opacity="0.8" TextWrapping="Wrap"
                                       IsVisible="{Binding Transfers.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="12" Margin="0,12,0,0"
                            BorderThickness="1" CornerRadius="6" BorderBrush="Gray">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Куда складывать принятое" FontWeight="SemiBold" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Обзор…" Margin="8,0,0,0"
                                        Command="{Binding Transfers.BrowseDownloadsCommand}" />
                                <TextBox Text="{Binding Transfers.DownloadsFolder}" />
                            </DockPanel>
                            <Button Content="Сохранить" HorizontalAlignment="Right"
                                    Command="{Binding Transfers.SaveDownloadsFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Входящие передачи" FontWeight="SemiBold" Opacity="0.8" />
                            <TextBlock Text="Пока нет входящих передач" Opacity="0.5" FontSize="12"
                                       IsVisible="{Binding !Transfers.IncomingOffers.Count}" />
                            <ItemsControl ItemsSource="{Binding Transfers.IncomingOffers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IncomingOfferItem">
                                        <Border Padding="10" Margin="0,0,0,8" CornerRadius="6"
                                                BorderThickness="1" BorderBrush="Gray">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding SenderName, StringFormat='Принять файлы от «{0}»?'}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="Отклонить" Command="{Binding RejectCommand}" />
                                                    <Button Content="Принять" Command="{Binding AcceptCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="К отправке" FontWeight="SemiBold" Opacity="0.8" />
                            <ItemsControl ItemsSource="{Binding Transfers.SelectedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OutgoingFileItem">
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <TextBlock Text="{Binding FileName}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10" Opacity="0.6">
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" />
                                                <TextBlock Text="{Binding FullPath}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Медиа -->
            <TabItem Header="Медиа">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,12"
                            BorderThickness="1" CornerRadius="6" BorderBrush="Gray">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Поиск фото и видео на этом устройстве" FontWeight="SemiBold" />
                            <TextBox PlaceholderText="Папка поиска" Text="{Binding Media.RootPath}" />
                            <TextBox PlaceholderText="Часть имени файла (необязательно)"
                                     Text="{Binding Media.NameFilter}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox Content="Фото" IsChecked="{Binding Media.IncludePhotos}" />
                                <CheckBox Content="Видео" IsChecked="{Binding Media.IncludeVideos}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Стоп" Command="{Binding Media.StopCommand}"
                                        IsEnabled="{Binding Media.IsScanning}" />
                                <Button Content="Искать" Command="{Binding Media.ScanCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Media.StatusMessage}" Opacity="0.8"
                                       IsVisible="{Binding Media.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Media.Results}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaItem">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FullPath}" Opacity="0.7" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Opacity="0.6">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" />
                                        <TextBlock Text="{Binding Size}" FontSize="11" />
                                        <TextBlock Text="{Binding ModifiedAt}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
